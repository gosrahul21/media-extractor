# Server Port (default: 3001)
PORT=3001

# AWS Credentials & S3 Storage
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=freakyfit-media

# SQS Queue URLs
# 1. Incoming Video Extraction Queue (Optional for local, used by Worker Lambda)
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/video-extraction-queue

# 2. Target Freakyfit-Backend SQS Queue to notify when video extraction finishes
BACKEND_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/freakyfit-backend-queue

# Google Gemini API Key (for uploading to Gemini File API and generating fileUri)
GEMINI_API_KEY=your_gemini_api_key

# Supabase Credentials (used to fetch dynamic rotating cookies)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional fallback cookies for YouTube/Instagram authentication
YOUTUBE_COOKIES=
